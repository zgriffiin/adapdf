{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adapdf",
  "version": "0.1.0",
  "identifier": "com.adapdf.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adapdf: accessible PDFs from Word",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Adapdf",
    "shortDescription": "Accessible PDFs from Word documents",
    "longDescription": "Checks Word training guides for accessibility problems, fixes what it safely can, and exports a tagged PDF with a report.",
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
